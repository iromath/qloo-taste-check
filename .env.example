# Required: Qloo hackathon API key (X-Api-Key)
QLOO_API_KEY=

# Qloo API base. Only the hackathon host is accepted by hackathon keys.
QLOO_API_BASE=https://hackathon.api.qloo.com

# Server
PORT=8787
PUBLIC_ORIGIN=http://localhost:8787

# Optional: allow browser demos from another origin
CORS_ORIGINS=

# Optional: private server-side cache TTL for Qloo responses, seconds
QLOO_CACHE_TTL=21600

# Optional: LLM-driven demo mode (omit to run the deterministic demo)
OPENAI_API_KEY=
